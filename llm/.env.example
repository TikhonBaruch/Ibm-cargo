# External LLM matrix — copy to `.env` and adjust

# Classification (OpenAI-compatible; stub if no key for the active profile)
# Temporary local test: NVIDIA NIM (also OPENAI_* fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_CLASSIFY_MODEL=meta/llama-3.1-8b-instruct
LLM_DUTY_MODEL=meta/llama-3.1-8b-instruct
LLM_TIMEOUT_MS=30000
TNVED_CODES_PATH=data/tnved/normalized/codes.jsonl
# Named classify profiles (one at a time via LLM_PROVIDER — not a multi-LLM mesh):
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# LLM_PROVIDER=qwen
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# Or OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_CLASSIFY_MODEL=gpt-4o-mini
# LLM_DUTY_MODEL=gpt-4o-mini

# Host ports (match LBM integration URLs)
CLASSIFICATION_PORT=4500
OCR_PORT=4700
LOGISTICS_PORT=4601
DOCUMENTS_PORT=4750
BROKER_PORT=4800
RISK_PORT=4900
GATEWAY_PORT=8088

# TN VED corpus (optional licensed adapters)
TKS_CLIENT_KEY=
TKS_API_BASE=https://api1.tks.ru
ALTA_API_URL=
ALTA_API_TOKEN=
ALTA_LOGIN=
ALTA_PASSWORD=
NSI_XML_URL=
FTS_DATASET_URL=
PSN_MAX_PAGES=120
PSN_DELAY_MS=400
ETT_DOWNLOAD_PDF=0
ETT_DOWNLOAD_SHEETS=1
ETT_MAX_FILES=
