{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lbm.local/contracts/d-ai.pipeline.json",
  "title": "D-AI sequential Qwen→DeepSeek pipeline",
  "description": "BackgroundJob AI_DRAIN: vision describe (Qwen or DeepSeek by chainId) → reset → classify against local TN VED corpus. UI never calls models. Overlay HS after heuristic AI_READY; do not stub-OK jobs.",
  "x-contractVersion": 1,
  "x-owner": "services/ocr",
  "x-taurusAlias": "d-ai.pipeline.json",
  "x-transport": [
    "POST /v1/internal/ai-drain",
    "POST /v1/describe",
    "POST /v1/reset",
    "POST /v1/classify"
  ],
  "definitions": {
    "describeRequest": {
      "type": "object",
      "properties": {
        "mediaUrl": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "chainId": {
          "description": "AI chain id (1|2|3) or slug; OCR picks vision backend. Defaults to AI_CHAIN_ID.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "describeResponse": {
      "type": "object",
      "required": [
        "engine",
        "description"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "attrs": {
          "type": "object"
        },
        "confidence": {
          "type": "number"
        },
        "disclaimer": {
          "type": "string"
        }
      }
    },
    "resetRequest": {
      "type": "object"
    },
    "resetResponse": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "engine": {
          "type": "string"
        },
        "skipped": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "classifyRequest": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "visionDescription": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "chainId": {
          "description": "AI chain id forwarded for logging / provider select",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "pipelineResult": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "visionDescription": {
          "type": [
            "string",
            "null"
          ]
        },
        "hsCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    }
  },
  "examples": {
    "describeRequest": {
      "mediaUrl": "https://example.com/tee.jpg",
      "hint": "майка",
      "chainId": 3
    },
    "describeResponse": {
      "engine": "qwen-vl-v1",
      "description": "Белая хлопковая майка, трикотаж, взрослый размер.",
      "attrs": {
        "material": "трикотаж",
        "purpose": "предмет одежды"
      },
      "confidence": 0.72
    },
    "resetRequest": {},
    "resetResponse": {
      "ok": true,
      "engine": "qwen-reset-v1"
    },
    "classifyRequest": {
      "title": "Партия маек",
      "name": "майка",
      "visionDescription": "Белая хлопковая майка"
    },
    "pipelineResult": {
      "ok": true,
      "visionDescription": "Белая хлопковая майка",
      "hsCode": "6109 10 000 0",
      "engine": "llm-openai-v1"
    }
  },
  "x-invariants": [
    "Create still heuristic AI_READY; pipeline overlays HS",
    "Reset in finally; reset failure does not roll back describe",
    "No image bytes in ServiceCall.requestMeta",
    "Unhandled job kind must finish FAILED not stub OK",
    "No live scrape of Alta/TKS",
    "OCR /v1/describe honors chainId (3→DeepSeek vision; else Qwen-VL)"
  ]
}
