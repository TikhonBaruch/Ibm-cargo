{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lbm.local/contracts/d-ocr.ai.json",
  "title": "D-OCR document extract",
  "description": "Optional OCR / docs-ingest behind create and PDF table import. Fail-open; writes item attrs (D24) via domain, no second FSM. Describe vision backend follows chainId / AI_CHAIN_ID (Qwen or DeepSeek). UIs never call this directly.",
  "x-contractVersion": 1,
  "x-owner": "services/ocr",
  "x-transport": [
    "POST /v1/extract",
    "POST /v1/extract-table",
    "POST /v1/describe",
    "POST /v1/reset",
    "GET /health"
  ],
  "definitions": {
    "extractRequest": {
      "type": "object",
      "properties": {
        "mediaUrl": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "hint": {
          "type": "string",
          "description": "Optional product title/description context"
        },
        "pdfBase64": {
          "type": "string",
          "description": "PDF bytes as base64 (table/create path)"
        },
        "imageBase64": {
          "type": "string",
          "description": "Image bytes for vision OCR"
        }
      },
      "additionalProperties": true
    },
    "extractResponse": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "attrs": {
          "type": "object",
          "description": "ProductAttrs-compatible partial (D24)",
          "additionalProperties": true
        },
        "items": {
          "type": "array",
          "description": "Optional line items from extract-table / vision",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "qty": {
                "type": "number"
              },
              "unitPrice": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "confidence": {
          "type": "number"
        },
        "disclaimer": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "describeRequest": {
      "type": "object",
      "properties": {
        "mediaUrl": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "imageBase64": {
          "type": "string"
        },
        "chainId": {
          "description": "1|2|3 or slug — selects vision provider",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "examples": {
    "extractRequest": {
      "mediaUrl": "https://example.com/invoice.pdf",
      "mimeType": "application/pdf",
      "hint": "ноутбуки"
    },
    "extractResponse": {
      "engine": "ocr-pdf-text-v1",
      "text": "Invoice … ThinkPad …",
      "attrs": {
        "brand": "Lenovo",
        "model": "ThinkPad"
      },
      "confidence": 0.65,
      "disclaimer": "Text-layer PDF extract (ocr-pdf-text-v1)."
    },
    "extractTableResponse": {
      "engine": "ocr-pdf-table-v1",
      "items": [
        {
          "name": "MacBook Pro",
          "unitPrice": 2000
        }
      ],
      "confidence": 0.7
    }
  },
  "x-invariants": [
    "Fail-open: domain create must not require OCR",
    "No Calculation status changes",
    "ServiceCall.service=ocr when invoked from api/ai",
    "Engines: ocr-stub-v0 | ocr-pdf-text-v1 | ocr-pdf-table-v1 | ocr-vision-v1"
  ]
}
