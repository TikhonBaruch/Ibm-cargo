{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://llm.local/contracts/d-documents.llm.json",
  "title": "AI Documents validate",
  "description": "Document pack checklist stub before customs filing.",
  "x-contractVersion": 1,
  "x-owner": "services/documents",
  "x-transport": ["POST /v1/validate", "GET /health"],
  "definitions": {
    "validateRequest": {
      "type": "object",
      "properties": {
        "documents": { "type": "array", "items": { "type": "string" } },
        "hsCode": { "type": "string" },
        "attrs": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "validateError": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "document": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validateResponse": {
      "type": "object",
      "properties": {
        "engine": { "type": "string" },
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/definitions/validateError" } },
        "disclaimer": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "examples": {
    "validateRequest": {
      "documents": ["invoice", "packing_list"],
      "hsCode": "8471 30 000 0"
    },
    "validateResponse": {
      "engine": "documents-stub-v0",
      "ok": false,
      "errors": [{ "code": "missing_doc", "document": "contract", "message": "Missing contract" }],
      "disclaimer": "Stub AI Documents."
    }
  }
}
