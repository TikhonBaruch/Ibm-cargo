{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://llm.local/contracts/d-logistics.llm.json",
  "title": "AI Logistics route",
  "description": "AI routing suggestions. Distinct from LBM 3PL containers/logistics D-SHIP.",
  "x-contractVersion": 1,
  "x-owner": "services/logistics",
  "x-transport": ["POST /v1/route", "GET /health"],
  "definitions": {
    "routeRequest": {
      "type": "object",
      "properties": {
        "cargoType": { "type": "string" },
        "description": { "type": "string" },
        "prefer": { "type": "string", "description": "balanced|price|speed" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "weightKg": { "type": "number" }
      },
      "additionalProperties": true
    },
    "routeOption": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mode": { "type": "string" },
        "carrier": { "type": "string" },
        "daysMin": { "type": "number" },
        "daysMax": { "type": "number" },
        "priceRub": { "type": "number" },
        "score": { "type": "number" }
      },
      "additionalProperties": true
    },
    "routeResponse": {
      "type": "object",
      "properties": {
        "engine": { "type": "string" },
        "options": { "type": "array", "items": { "$ref": "#/definitions/routeOption" } },
        "disclaimer": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "examples": {
    "routeRequest": { "cargoType": "electronics", "prefer": "speed" },
    "routeResponse": {
      "engine": "logistics-ai-stub-v0",
      "options": [{ "id": "air-demo", "mode": "air", "priceRub": 210000 }],
      "disclaimer": "Stub AI Logistics."
    }
  }
}
