# Database — dedicated Postgres for LBM (Ibm-cargo), not shared with other apps.
# D36: never point this URL at taurus/llm or nested ./llm databases or volumes.
# Zero coupling: no sync/mount/build from ./llm — containers/{llm,ocr} are LBM-owned.
# As-is sweb LBM (docs/knowledge/database.md). Password only in gitignored .env — never commit it.
# Port 5433 + sslmode=require. A "#" in a pasted URL is a fragment, not the password.
# Extra colon after port (:5433:/db) is invalid — use :5433/db.
# Agents: canon is repo-root .env. Duplicate the working DATABASE_URL to
# app/.env (agents that look under App Router) and prisma/.env (Prisma CLI).
# Not git. Not `vercel env pull` ([SENSITIVE]). If DATABASE_URL is already
# set in the process: `env -u DATABASE_URL` before Prisma CLI.
DATABASE_URL="postgresql://newlsu_lbm:YOUR_PASSWORD@pg4.sweb.ru:5433/newlsu_lbm?schema=public&connect_timeout=15&sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin (legacy bootstrap)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin-password"

# Ops panel (SUPER_ADMIN /2178737 «Инфраструктура и доступы») — optional, never commit real values
# OPS_HOST="https://hosting-panel.example"
# OPS_USER=""
# OPS_PASSWORD=""
# OPS_NOTES=""
# OPS_SSH_HOST="ssh.example.com"
# OPS_SSH_USER="root"
# OPS_SSH_PASSWORD=""
# OPS_SSH_KEY_HINT="path or fingerprint"
# OPS_SSH_NOTES=""

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_BOT_SECRET="your-bot-secret"
TELEGRAM_ADMIN_CHAT_ID="your-admin-chat-id"
TELEGRAM_AUTHOR_CHAT_ID=""
TELEGRAM_CHANNEL_ID=""

# S3 Storage — LBM uses its own bucket (not shared with other projects)
# Reg.ru example (region us-east-1 for S3 API compatibility):
S3_BUCKET="lbm"
S3_ENDPOINT="https://s3.regru.cloud"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
# Optional: extra absolute mediaUrl prefixes for vision/OCR fetch (comma-separated). Default allowlist = S3 base + /uploads/ved/*
# MEDIA_URL_ALLOWED_PREFIXES="https://cdn.example"
# Optional: public-read so cabinet <img mediaUrl> works (bucket must allow ACLs)
# S3_OBJECT_ACL="public-read"

# Notify email on Vercel (no notify container): Resend inline via kickNotifyDelivery
# RESEND_API_KEY=
# SMTP_FROM="noreply@your-domain.com"
# Or Compose: NOTIFY_SERVICE_URL=http://notify:4400 + RESEND/SMTP on notify host

# Precedent field typeahead (optional — Compose scale/full; Vercel uses in-process Prisma)
# PRECEDENTS_SERVICE_URL=http://precedents:4800
# PRECEDENTS_PORT=4800

# Tests
TEST_API_URL="http://localhost:3000"

# Cabinet UI (default off — set to 1 to show client «Перевозка» pane)
# NEXT_PUBLIC_SHIPPING_UI=0

# Local AI stub (docker compose service ai)
NEXT_PUBLIC_AI_URL="http://localhost:4100"
AI_SERVICE_URL="http://localhost:4100"
API_SERVICE_URL="http://localhost:4000"

# Optional LLM enrich (OpenAI-compatible). One active chat backend via LLM_PROVIDER.
# Compose: keys on llm/ocr services + LLM_SERVICE_URL / OCR_SERVICE_URL.
# Vercel: set LLM_PROVIDER=deepseek + DEEPSEEK_* (+ QWEN_* for vision) on the Next project —
# domain calls providers directly (no docker DNS). Gate: ved.llmEnrichEnabled.
# Temporary NVIDIA NIM (also used for OCR/embeddings if OPENAI_* set):
# OPENAI_API_KEY=nvapi-…
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_CLASSIFY_MODEL=meta/llama-3.1-8b-instruct
# LLM_DUTY_MODEL=meta/llama-3.1-8b-instruct
# Named classify profiles (containers/llm only; not the D30 multi-LLM mesh):
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# LLM_PROVIDER=qwen
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# QWEN_VISION_MODEL=qwen-vl-plus
# LLM_TIMEOUT_MS=120000
# OCR_TIMEOUT_MS=90000
# Vision describe waits this long before classify; media fetch uses the same budget (no 15s cap).
# AI_DRAIN route maxDuration=300 — fits vision + classify.
# Parallel AI chains (docs/knowledge/plan-ai-chains-1-2-3.md):
# 1=nvidia legacy · 2=qwen-vl+deepseek (default prod) · 3=deepseek vision+classify only
# AI_CHAIN_ID=2
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# LLM_CLASSIFY_CHAIN=deepseek,qwen
# Client waits up to 180s (poll) for AI_DRAIN; create returns fast with llmEnrichPending.
# Failover: DeepSeek→Qwen-chat→lexical; job requeue 30s→2m→5m→15m (see ai-drain-retry).
# LLM_SERVICE_URL=http://127.0.0.1:4500   # host dev / Mode A only; Compose uses http://llm:4500 internally
# OCR_SERVICE_URL=http://127.0.0.1:4700
# Without Docker: npm run mesh:up  (same ports). With Docker: npm run docker:scale

# Precedent pgvector (БД-2 semantic match, compose/local):
# PRECEDENT_VECTOR_ENABLED=1          # set 0 to disable
# PRECEDENT_EMBED_MODEL=nvidia/nv-embedqa-e5-v5   # or text-embedding-3-small
# PRECEDENT_EMBED_DIM=1024
# PRECEDENT_VECTOR_THRESHOLD=0.78     # cosine similarity min for precedent-v2
# PRECEDENT_EMBED_TIMEOUT_MS=15000
