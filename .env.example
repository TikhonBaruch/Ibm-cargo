# ibm-cargo — local monorepo env map (example only; copy pieces into package .env files)
# Do not put secrets here in git. Real local files:
#   taurus/.env  — Next / Prisma / Auth
#   llm/.env     — classification / OCR matrix
#
# App (taurus/) — Mode A
# DATABASE_URL=postgresql://taurus:taurus@127.0.0.1:5432/taurus?schema=public&connect_timeout=15
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=change-me
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ALLOW_MOCK_TOPUP=1
# AI_SERVICE_URL=http://127.0.0.1:4100
# LLM_SERVICE_URL=http://127.0.0.1:4500
# OCR_SERVICE_URL=http://127.0.0.1:4700
#
# Matrix (llm/)
# CLASSIFICATION_PORT=4500
# OCR_PORT=4700
# TNVED_CODES_PATH=data/tnved/normalized/codes.jsonl
