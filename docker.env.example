# Docker Compose local overrides (copy to .env for compose variable substitution)
POSTGRES_USER=lbm
POSTGRES_PASSWORD=lbm
POSTGRES_DB=lbm
POSTGRES_PORT=5432
REDIS_PORT=6379

WEB_PORT=3000
ADMIN_PORT=3001
BROKER_PORT=3002
CLIENT_PORT=3003
API_PORT=4000
AI_PORT=4100
WORKER_PORT=4200
PAYMENTS_PORT=4300
NOTIFY_PORT=4400
LLM_PORT=4500
LOGISTICS_PORT=4600
OCR_PORT=4700
GATEWAY_PORT=8080

WEB_ORIGIN=http://localhost:3000
WEB_API_ORIGIN=http://web:3000
WEB_SERVICE_URL=http://web:3000
INTERNAL_API_KEY=dev-secret-change-me
SLA_TICK_INTERVAL_MS=60000
# Growth providers (scale/full)
# Temporary online LLM — NVIDIA NIM (OpenAI-compatible); keep for OCR/embeddings:
# OPENAI_API_KEY=nvapi-…
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_CLASSIFY_MODEL=meta/llama-3.1-8b-instruct
# LLM_DUTY_MODEL=meta/llama-3.1-8b-instruct
# Classify-only profiles (llm service; LLM_PROVIDER=deepseek|qwen|nvidia):
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# QWEN_VISION_MODEL=qwen-vl-plus
# OCR_TIMEOUT_MS=90000
# LLM_TIMEOUT_MS=120000
# Vision-before-classify: describe uses OCR_TIMEOUT_MS; classify waits until vision OK (or last AI_DRAIN attempt).
# LLM_SERVICE_URL=http://llm:4500
# OCR_SERVICE_URL=http://ocr:4700
# Build classify/ocr from sibling matrix (canon) instead of containers/* mirrors:
# LLM_DOCKER_CONTEXT=./llm/services/classification
# OCR_DOCKER_CONTEXT=./llm/services/ocr
# Or keep mirrors in sync: npm run sync:ai-matrix
# Local VED uploads (Compose web): volume ved_uploads → /app/public/uploads when S3_* unset.
# Without S3 on Vercel → 503; locally files persist in Docker volume ved_uploads.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_RETURN_URL=http://localhost:3000/cabinet/balance?topup=1
# YOOKASSA_SKIP_BASIC_AUTH=0
# ALLOW_FORCE_CONFIRM=0
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example:465
# NOTIFY_OPS_EMAIL=ops@example.com
# LOGISTICS_PROVIDER=demo
# NEXT_PUBLIC_SHIPPING_UI=0
# WEB_SURFACE=full
# Vercel / durable media (Yandex Object Storage)
# S3_BUCKET=
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Compose web sets USE_DOMAIN_API=1 by default (C1). Leave unset on Vercel.
# USE_DOMAIN_API=1
# DOMAIN_API_URL=http://localhost:4000
# PAYMENTS_SERVICE_URL=http://payments:4300
# PAYMENTS_WEBHOOK_TARGET=http://api:4000/v1/webhooks/payments
# NOTIFY_SERVICE_URL=http://notify:4400
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AI_URL=http://localhost:4100
REDIS_URL=redis://redis:6379

# Для web-контейнера с локальным postgres из compose:
# Compose api/web/worker use in-network postgres (see docker-compose.yml) — host DATABASE_URL is NOT passed through.
# DATABASE_URL=postgresql://lbm:lbm@postgres:5432/lbm?schema=public

# Или внешняя БД (пароль URL-encode: # → %23):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require

# Demo mock company topup (D13). Required on production Vercel for demo balances.
ALLOW_MOCK_TOPUP=1
