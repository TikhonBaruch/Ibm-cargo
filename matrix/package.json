{
  "name": "@kargo/llm-matrix",
  "version": "0.1.0",
  "private": true,
  "description": "External LLM service matrix for Taurus (Classification, OCR, Broker, Risk, Logistics, Documents)",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start:classification": "npm run start -w @kargo/llm-classification",
    "start:ocr": "npm run start -w @kargo/llm-ocr",
    "start:broker": "npm run start -w @kargo/llm-broker",
    "start:risk": "npm run start -w @kargo/llm-risk",
    "start:logistics": "npm run start -w @kargo/llm-logistics",
    "start:documents": "npm run start -w @kargo/llm-documents",
    "dev:classification": "npm run dev -w @kargo/llm-classification",
    "smoke": "node scripts/smoke.mjs",
    "tnved:fetch-psn": "node scripts/fetch-eec-psn.mjs",
    "tnved:parse-psn": "node scripts/parse-psn-pdf.mjs",
    "tnved:fetch-ett": "node scripts/fetch-eec-ett-index.mjs",
    "tnved:parse-ett": "node scripts/parse-ett-tabular.mjs",
    "tnved:fetch-nsi": "node scripts/fetch-eec-nsi.mjs",
    "tnved:fetch-fts": "node scripts/fetch-fts-opendata.mjs",
    "tnved:fetch-classifications": "node scripts/fetch-eec-classifications.mjs",
    "tnved:fetch-kz": "node scripts/fetch-kz-ett.mjs",
    "tnved:parse-fts": "node scripts/parse-fts-rates.mjs",
    "tnved:parse-tws": "node scripts/parse-tws-csv.mjs",
    "tnved:normalize": "node scripts/normalize-tnved.mjs",
    "tnved:export-import": "node scripts/export-taurus-import.mjs",
    "tnved:adapter-tks": "node scripts/adapters/tks-archive.mjs",
    "tnved:adapter-alta": "node scripts/adapters/alta-api.mjs",
    "tnved:corpus": "npm run tnved:fetch-ett && npm run tnved:parse-ett && npm run tnved:fetch-nsi && npm run tnved:fetch-fts && npm run tnved:parse-fts && npm run tnved:parse-tws && npm run tnved:normalize && npm run tnved:export-import"
  },
  "engines": {
    "node": ">=20"
  }
}
