# Frontend contractor — localhost only. Copy to .env on the second machine.
# Do NOT paste production DATABASE_URL, S3_*, LLM keys, or Vercel tokens here.

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-value-from-SECRETS-ENVELOPE-or-openssl-rand-base64-32"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Keep shipping hidden (D27). Factory chrome follows live flags; do not invent new flags.
# NEXT_PUBLIC_SHIPPING_UI=0
# NEXT_PUBLIC_FACTORY_UI=1

# Intentionally absent:
# DATABASE_URL
# S3_BUCKET S3_ENDPOINT S3_ACCESS_KEY S3_SECRET_KEY
# DEEPSEEK_API_KEY QWEN_API_KEY OPENAI_API_KEY
# LLM_SERVICE_URL OCR_SERVICE_URL AI_SERVICE_URL
# VERCEL_TOKEN USE_DOMAIN_API
