# Optional local overrides for Next (Mode A).
# Copy to .env.local — never commit secrets.
#
# Do NOT set DATABASE_URL or S3_* here.
# Dedicated Postgres + S3 bucket `lbm` live only in .env (or Vercel Env).

NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOW_MOCK_TOPUP=1

# Optional local mesh stubs (ibm-cargo compose profile core), if you run containers:
# AI_SERVICE_URL=http://127.0.0.1:4100
# LLM_SERVICE_URL=http://127.0.0.1:4500
# OCR_SERVICE_URL=http://127.0.0.1:4700
# LLM_TIMEOUT_MS=30000
# OCR_TIMEOUT_MS=20000
